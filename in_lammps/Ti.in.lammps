units metal
dimension 3
boundary p p p
atom_style atomic

lattice custom 2.95 &
  a1 1.0 0.0 0.0 &
  a2 -0.5 0.8660254038 0.0 &
  a3 0.0 0.0 1.586440678 &
  basis 0.0 0.0 0.0 &
  basis 0.6666666667 0.3333333333 0.5

region box block 0 6 0 6 0 6
create_box 1 box
create_atoms 1 box
replicate 10 10 2

mass 1 47.867

pair_style deepmd ${dp_test}
pair_coeff * *

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

velocity all create 300.0 12345 mom yes rot yes dist gaussian
fix 1 all nvt temp 300.0 300.0 0.1

timestep 0.001
thermo 100
thermo_style custom step temp pe ke etotal press vol

dump 1 all custom 100 ti.lammpstrj id type x y z

run 100
